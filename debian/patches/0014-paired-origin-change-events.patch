+        d->previous_valid = d->reference_initialized && d->capture != 0;
+        d->previous_orientation = d->orientation;
+        d->previous_capture = mono_now + ((int64_t)d->capture - (int64_t)boot_now);
+        d->previous_reference_time = d->reference_time;
