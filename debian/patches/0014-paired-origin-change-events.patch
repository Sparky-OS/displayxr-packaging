diff --git a/tests/tests_rdp_head.cpp b/tests/tests_rdp_head.cpp
new file mode 100644
index 000000000..eccb5ac46
--- /dev/null
+++ b/tests/tests_rdp_head.cpp
@@ -0,0 +1,143 @@
+// Copyright 2026 Daniel Campos Ramos
+// SPDX-License-Identifier: BSL-1.0
+#include "catch_amalgamated.hpp"
+extern "C" {
+#include "target_rdp_head.h"
+#include "xrt/xrt_session.h"
+#include "os/os_time.h"
+}
+#include <array>
+#include <cstring>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <time.h>
+
+namespace {
+using Packet = std::array<uint8_t, 160>;
+void put(Packet &p, unsigned offset, uint64_t value, unsigned count)
+{
+    for (unsigned i = 0; i < count; ++i) p[offset + i] = uint8_t(value >> (8 * i));
+}
+uint64_t boot()
+{
+    timespec t{}; REQUIRE(clock_gettime(CLOCK_BOOTTIME, &t) == 0);
+    return uint64_t(t.tv_sec) * 1000000000ULL + uint64_t(t.tv_nsec);
+}
+struct EventSink {
+    xrt_session_event_sink base{};
+    std::vector<xrt_session_event_reference_space_change_pending> *events;
+};
+struct Fixture {
+    EventSink sink{};
+    std::vector<xrt_session_event_reference_space_change_pending> events;
+    xrt_device *device = nullptr;
+    int peer = -1;
+    char directory[64] = "/tmp/displayxr-rdp-head-XXXXXX";
+    std::string old_runtime;
+    bool had_runtime;
+    Fixture() : had_runtime(getenv("XDG_RUNTIME_DIR") != nullptr)
+    {
+        if (had_runtime) old_runtime = getenv("XDG_RUNTIME_DIR");
+        REQUIRE(mkdtemp(directory) != nullptr);
+        REQUIRE(setenv("XDG_RUNTIME_DIR", directory, 1) == 0);
+        sink.events = &events;
+        sink.base.push_event = [](xrt_session_event_sink *s, const union xrt_session_event *event) {
+            auto *sink = reinterpret_cast<EventSink *>(s);
+            sink->events->push_back(event->ref_change);
+            return XRT_SUCCESS;
+        };
+        device = t_rdp_head_create(&sink.base); REQUIRE(device != nullptr);
+        connect_peer();
+    }
+    ~Fixture()
+    {
+        if (peer >= 0) close(peer);
+        if (device) xrt_device_destroy(&device);
+        rmdir((std::string(directory) + "/stereodroidvr").c_str());
+        rmdir(directory);
+        if (had_runtime) setenv("XDG_RUNTIME_DIR", old_runtime.c_str(), 1);
+        else unsetenv("XDG_RUNTIME_DIR");
+    }
+    void connect_peer()
+    {
+        peer = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0); REQUIRE(peer >= 0);
+        sockaddr_un address{}; address.sun_family = AF_UNIX;
+        const auto path = std::string(directory) + "/stereodroidvr/pose";
+        std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+        REQUIRE(connect(peer, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0);
+    }
+    Packet packet(unsigned kind, unsigned identity = 1)
+    {
+        Packet p{}; std::memcpy(p.data(), "SDVR", 4); put(p, 4, 1, 2); put(p, 6, kind, 2);
+        for (unsigned i = 8; i < 72; ++i) p[i] = uint8_t(identity);
+        return p;
+    }
+    void send_packet(const Packet &p) { REQUIRE(send(peer, p.data(), p.size(), MSG_NOSIGNAL) == ssize_t(p.size())); }
+    void send_pose(uint64_t capture, uint64_t origin, std::array<double, 4> q, unsigned identity = 1)
+    {
+        auto p = packet(1, identity); put(p, 72, capture, 8); put(p, 80, capture, 8);
+        put(p, 88, 1000000, 8); put(p, 96, origin, 8); put(p, 144, 1, 4);
+        for (unsigned i = 0; i < 4; ++i) { uint64_t bits; std::memcpy(&bits, &q[i], 8); put(p, 104 + 8 * i, bits, 8); }
+        send_packet(p);
+    }
+    xrt_space_relation locate(int64_t at = os_monotonic_get_ns())
+    {
+        xrt_space_relation result{};
+        REQUIRE(device->get_tracked_pose(device, XRT_INPUT_GENERIC_HEAD_POSE, at, &result) == XRT_SUCCESS);
+        return result;
+    }
+};
+}
+
+TEST_CASE("Paired recenter notifies the world reference spaces at capture time", "[rdp-head]")
+{
+    Fixture f;
+    f.send_packet(f.packet(0));
+    const auto first_capture = boot() - 3000000;
+    f.send_pose(first_capture, 1, {0, .5, 0, .8660254037844386});
+    REQUIRE(f.locate().relation_flags != 0);
+    REQUIRE(f.events.empty());
+    f.send_packet(f.packet(2));
+    REQUIRE(f.locate().relation_flags == 0);
+    const auto second_capture = boot() - 1000000;
+    f.send_pose(second_capture, 2, {0, 0, 0, 1});
+    REQUIRE(f.locate().pose.orientation.w == 1.f);
+    REQUIRE(f.events.size() == 3);
+    const auto change = f.events[0].timestamp_ns;
+    const auto expected = os_monotonic_get_ns() + (int64_t(second_capture) - int64_t(boot()));
+    REQUIRE(std::llabs(change - expected) < 1000000);
+    const xrt_reference_space_type spaces[] = {XRT_SPACE_REFERENCE_TYPE_LOCAL, XRT_SPACE_REFERENCE_TYPE_LOCAL_FLOOR, XRT_SPACE_REFERENCE_TYPE_STAGE};
+    for (unsigned i = 0; i < 3; ++i) {
+        REQUIRE(f.events[i].event_type == XRT_SESSION_EVENT_REFERENCE_SPACE_CHANGE_PENDING);
+        REQUIRE(f.events[i].ref_type == spaces[i]);
+        REQUIRE(f.events[i].timestamp_ns == change);
+        REQUIRE_FALSE(f.events[i].pose_valid);
+    }
+    const auto before = f.locate(change - 1);
+    REQUIRE(before.relation_flags != 0);
+    REQUIRE(before.pose.orientation.y == .5f);
+    REQUIRE(f.locate(change).pose.orientation.y == 0.f);
+    REQUIRE(f.locate(change).pose.orientation.w == 1.f);
+    REQUIRE(f.locate(change - 200000000).relation_flags == 0);
+    f.send_pose(boot(), 2, {0, 0, 0, 1});
+    f.locate(); REQUIRE(f.events.size() == 3);
+    usleep(110000);
+    REQUIRE(f.locate().relation_flags == 0);
+}
+
+TEST_CASE("A new paired source invalidates history even when its origin serial repeats", "[rdp-head]")
+{
+    Fixture f;
+    f.send_packet(f.packet(0)); f.send_pose(boot(), 1, {0, 0, 0, 1});
+    REQUIRE(f.locate().relation_flags != 0);
+    close(f.peer); f.peer = -1;
+    REQUIRE(f.locate().relation_flags == 0);
+    f.connect_peer(); f.send_packet(f.packet(0, 2)); f.send_pose(boot(), 1, {0, .5, 0, .8660254037844386}, 2);
+    REQUIRE(f.locate().relation_flags != 0);
+    REQUIRE(f.events.size() == 3);
+    REQUIRE(f.locate(f.events[0].timestamp_ns - 1).relation_flags == 0);
+}
