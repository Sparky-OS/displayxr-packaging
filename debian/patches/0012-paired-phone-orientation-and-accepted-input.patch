diff --git a/src/xrt/drivers/gamepad/gamepad_evdev_core.c b/src/xrt/drivers/gamepad/gamepad_evdev_core.c
new file mode 100644
index 000000000..3820991fe
--- /dev/null
+++ b/src/xrt/drivers/gamepad/gamepad_evdev_core.c
@@ -0,0 +1,325 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  The Linux pad reader's device layer. See the header.
+ *
+ * @ingroup drv_gamepad
+ */
+
+#include "xrt/xrt_config_os.h"
+
+#ifdef XRT_OS_LINUX_DESKTOP
+
+#include "gamepad_evdev_core.h"
+
+#include <errno.h>
+#include <linux/input.h>
+#include <stdio.h>
+#include <string.h>
+
+#define CORE_BATCH 64
+
+static void
+say(struct gamepad_evdev_core *c, int level, const char *fmt, const char *a, const char *b)
+{
+	char line[256];
+	snprintf(line, sizeof(line), fmt, a, b);
+	c->ops.say(c->ops.ctx, level, line);
+}
+
+static bool
+skipped_has(const struct gamepad_evdev_core *c, const char *path)
+{
+	for (int i = 0; i < c->skipped_count; i++) {
+		if (strcmp(c->skipped[i], path) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+skipped_add(struct gamepad_evdev_core *c, const char *path)
+{
+	if (c->skipped_count < (int)(sizeof(c->skipped) / sizeof(c->skipped[0])) && !skipped_has(c, path)) {
+		snprintf(c->skipped[c->skipped_count++], GAMEPAD_EVDEV_PATH_MAX, "%s", path);
+	}
+}
+
+static struct gamepad_evdev_pad *
+pad_by_path(struct gamepad_evdev_core *c, const char *path)
+{
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		if (c->pads[i].used && strcmp(c->pads[i].path, path) == 0) {
+			return &c->pads[i];
+		}
+	}
+	return NULL;
+}
+
+static void
+drop_pad(struct gamepad_evdev_core *c, struct gamepad_evdev_pad *p, const char *why)
+{
+	say(c, 1, "gamepad: pad %s is gone: %s.", p->name, why);
+	c->ops.close(c->ops.ctx, p->fd);
+	memset(p, 0, sizeof(*p));
+}
+
+struct scan_state
+{
+	struct gamepad_evdev_core *core;
+	// the paths the list emitted this time, to forget what left
+	char seen[64][GAMEPAD_EVDEV_PATH_MAX];
+	int seen_count;
+	int opened;
+	int denied;
+};
+
+static void
+consider(void *user, const char *path)
+{
+	struct scan_state *st = (struct scan_state *)user;
+	struct gamepad_evdev_core *c = st->core;
+	if (st->seen_count < (int)(sizeof(st->seen) / sizeof(st->seen[0]))) {
+		snprintf(st->seen[st->seen_count++], GAMEPAD_EVDEV_PATH_MAX, "%s", path);
+	}
+	if (pad_by_path(c, path) != NULL || skipped_has(c, path)) {
+		return;
+	}
+	struct gamepad_evdev_pad *slot = NULL;
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		if (!c->pads[i].used) {
+			slot = &c->pads[i];
+			break;
+		}
+	}
+	if (slot == NULL) {
+		return; // eight pads are read; a ninth waits until one goes
+	}
+	const int fd = c->ops.open(c->ops.ctx, path);
+	if (fd < 0) {
+		// A node the session may not read is normal (keyboards, mice) and is tried again at the next scan: udev
+		// gives a pad's node its ACL a moment after the node appears. The scan says it once when nothing at all
+		// could be read.
+		if (-fd == EACCES || -fd == EPERM) {
+			st->denied++;
+			return;
+		}
+		char reason[64];
+		snprintf(reason, sizeof(reason), "error %d", -fd);
+		say(c, 1, "gamepad: cannot open %s: %s.", path, reason);
+		skipped_add(c, path);
+		return;
+	}
+	st->opened++;
+	struct gamepad_evdev_caps caps;
+	char name[64] = {0};
+	const enum gamepad_evdev_probe pr = c->ops.probe(c->ops.ctx, fd, &caps, name, sizeof(name));
+	if (pr != GP_EVDEV_PROBE_PAD) {
+		c->ops.close(c->ops.ctx, fd);
+		if (pr == GP_EVDEV_PROBE_ERROR) {
+			say(c, 1, "gamepad: cannot read the capabilities of %s%s.", path, "");
+		}
+		skipped_add(c, path);
+		return;
+	}
+	memset(slot, 0, sizeof(*slot));
+	slot->used = true;
+	slot->fd = fd;
+	snprintf(slot->path, sizeof(slot->path), "%s", path);
+	snprintf(slot->name, sizeof(slot->name), "%s", name[0] ? name : "pad");
+	gamepad_evdev_decoder_init(&slot->dec, &caps);
+	// A pad that was already held when it was found starts from its real state.
+	c->ops.resync(c->ops.ctx, fd, &slot->dec);
+	gamepad_evdev_decoder_commit(&slot->dec);
+	slot->last_report_ns = c->ops.now_ns(c->ops.ctx);
+	say(c, 0, "gamepad: pad attached: %s at %s.", slot->name, path);
+}
+
+static void
+scan(struct gamepad_evdev_core *c)
+{
+	struct scan_state st;
+	memset(&st, 0, sizeof(st));
+	st.core = c;
+	const int n = c->ops.list(c->ops.ctx, consider, &st);
+	c->last_scan_ns = c->ops.now_ns(c->ops.ctx);
+	c->scanned_once = true;
+	if (n < 0) {
+		if (!c->list_failed_said) {
+			c->list_failed_said = true;
+			say(c, 1, "gamepad: the input directory cannot be read; no pad is available.", "", "");
+		}
+		return;
+	}
+	c->list_failed_said = false;
+	if (st.denied > 0 && st.opened == 0 && gamepad_evdev_core_pad_count(c) == 0) {
+		if (!c->denied_said) {
+			c->denied_said = true;
+			say(c, 1,
+			    "gamepad: no input node can be read by this user (the pad's node is readable by the session "
+			    "that owns the seat, or by the group input); no pad is available until one can.",
+			    "", "");
+		}
+	} else {
+		c->denied_said = false;
+	}
+	// forget what left the list, so a node that returns is looked at again
+	for (int i = 0; i < c->skipped_count;) {
+		bool still = false;
+		for (int j = 0; j < st.seen_count; j++) {
+			if (strcmp(c->skipped[i], st.seen[j]) == 0) {
+				still = true;
+				break;
+			}
+		}
+		if (still) {
+			i++;
+		} else {
+			memmove(c->skipped[i], c->skipped[c->skipped_count - 1], GAMEPAD_EVDEV_PATH_MAX);
+			c->skipped_count--;
+		}
+	}
+	// a pad whose node left the list is gone even if its descriptor still reads
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		struct gamepad_evdev_pad *p = &c->pads[i];
+		if (!p->used) {
+			continue;
+		}
+		bool listed = false;
+		for (int j = 0; j < st.seen_count; j++) {
+			if (strcmp(p->path, st.seen[j]) == 0) {
+				listed = true;
+				break;
+			}
+		}
+		if (!listed) {
+			drop_pad(c, p, "its node left /dev/input");
+		}
+	}
+}
+
+void
+gamepad_evdev_core_init(struct gamepad_evdev_core *c, const struct gamepad_evdev_ops *ops)
+{
+	memset(c, 0, sizeof(*c));
+	c->ops = *ops;
+}
+
+// When the batch's last report happened, by the kernel's own stamp: two pads read in one poll keep the order in which
+// they were touched, not the order in which they are read. A report with no stamp takes the time of the read.
+static int64_t
+last_report_time(const struct input_event *ev, size_t count, int64_t read_time)
+{
+	for (size_t i = count; i-- > 0;) {
+		if (ev[i].type == EV_SYN && ev[i].code == SYN_REPORT) {
+			const int64_t ns = (int64_t)ev[i].input_event_sec * 1000000000LL + (int64_t)ev[i].input_event_usec * 1000LL;
+			return ns != 0 ? ns : read_time;
+		}
+	}
+	return read_time;
+}
+
+static void
+read_pad(struct gamepad_evdev_core *c, struct gamepad_evdev_pad *p)
+{
+	struct input_event ev[CORE_BATCH];
+	for (;;) {
+		const ssize_t n = c->ops.read(c->ops.ctx, p->fd, ev, sizeof(ev));
+		if (n < 0) {
+			if (errno == EAGAIN || errno == EINTR) {
+				return;
+			}
+			drop_pad(c, p, errno == ENODEV ? "unplugged" : "read failed");
+			return;
+		}
+		if (n == 0) {
+			drop_pad(c, p, "end of file");
+			return;
+		}
+		const size_t count = (size_t)n / sizeof(struct input_event);
+		if (gamepad_evdev_decoder_feed(&p->dec, ev, count)) {
+			p->last_report_ns = last_report_time(ev, count, c->ops.now_ns(c->ops.ctx));
+		}
+		if (p->dec.needs_resync) {
+			// The kernel dropped events: take the device's own state, not the lost batch's.
+			c->ops.resync(c->ops.ctx, p->fd, &p->dec);
+			p->dec.needs_resync = false;
+			gamepad_evdev_decoder_commit(&p->dec);
+			p->last_report_ns = c->ops.now_ns(c->ops.ctx);
+		}
+		if ((size_t)n < sizeof(ev)) {
+			return;
+		}
+	}
+}
+
+void
+gamepad_evdev_core_poll(struct gamepad_evdev_core *c, struct gamepad_state *out)
+{
+	const int64_t now = c->ops.now_ns(c->ops.ctx);
+	const bool changed = c->ops.changed(c->ops.ctx);
+	const bool missing = gamepad_evdev_core_pad_count(c) == 0;
+	if (!c->scanned_once || changed || (missing && now - c->last_scan_ns >= GAMEPAD_EVDEV_RESCAN_NS)) {
+		scan(c);
+	}
+
+	struct gamepad_evdev_pad *best = NULL;
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		struct gamepad_evdev_pad *p = &c->pads[i];
+		if (!p->used) {
+			continue;
+		}
+		read_pad(c, p);
+		if (p->used && (best == NULL || p->last_report_ns > best->last_report_ns)) {
+			best = p;
+		}
+	}
+	if (best == NULL) {
+		memset(out, 0, sizeof(*out));
+		out->connected = false;
+		return;
+	}
+	*out = best->dec.state;
+	out->connected = true;
+}
+
+void
+gamepad_evdev_core_fini(struct gamepad_evdev_core *c)
+{
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		if (c->pads[i].used) {
+			c->ops.close(c->ops.ctx, c->pads[i].fd);
+			memset(&c->pads[i], 0, sizeof(c->pads[i]));
+		}
+	}
+}
+
+int
+gamepad_evdev_core_pad_count(const struct gamepad_evdev_core *c)
+{
+	int n = 0;
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		n += c->pads[i].used ? 1 : 0;
+	}
+	return n;
+}
+
+const char *
+gamepad_evdev_core_speaking_name(const struct gamepad_evdev_core *c)
+{
+	const struct gamepad_evdev_pad *best = NULL;
+	for (int i = 0; i < GAMEPAD_EVDEV_MAX_PADS; i++) {
+		const struct gamepad_evdev_pad *p = &c->pads[i];
+		if (p->used && (best == NULL || p->last_report_ns > best->last_report_ns)) {
+			best = p;
+		}
+	}
+	return best != NULL ? best->name : "";
+}
+
+#else
+// Keep the translation unit non-empty where this layer is compiled out (-Wempty-translation-unit).
+typedef int gamepad_evdev_core_not_built_here_t;
+#endif // XRT_OS_LINUX_DESKTOP
diff --git a/src/xrt/drivers/gamepad/gamepad_evdev_core.h b/src/xrt/drivers/gamepad/gamepad_evdev_core.h
new file mode 100644
index 000000000..d2ae503d2
--- /dev/null
+++ b/src/xrt/drivers/gamepad/gamepad_evdev_core.h
@@ -0,0 +1,118 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  The Linux pad reader's device layer: which pads exist, which one speaks, and what happens when one goes.
+ *
+ * It owns no system call. Everything it needs from the system comes through @ref gamepad_evdev_ops, so
+ * `tests/tests_gamepad_evdev.cpp` runs it on pipes and a scripted device list (hot plug, two pads, a pad that
+ * goes away, a node that cannot be opened) and the real backend (`gamepad_backend_evdev.c`) hands it /dev/input.
+ *
+ * Rules:
+ *   - every attached pad is read; the pad whose last report is newest speaks ("last used wins": a second pad
+ *     lying on the desk does not hold the first);
+ *   - a pad that fails to read (ENODEV, end of file) is closed and forgotten; the next pad takes over, and with
+ *     none left the state is not connected;
+ *   - the node list is read again when the system says it changed (@ref gamepad_evdev_ops::changed) and at
+ *     most every @ref GAMEPAD_EVDEV_RESCAN_NS while a pad is missing, so a node whose permissions arrive a
+ *     moment after it appears (udev's ACL) is tried again;
+ *   - a node that cannot be opened is said once, by name and reason, not every scan; a node that is not a pad
+ *     is not opened again until it goes.
+ *
+ * Called from the hub's poll thread only.
+ *
+ * @ingroup drv_gamepad
+ */
+
+#pragma once
+
+#include "gamepad_evdev_decode.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GAMEPAD_EVDEV_MAX_PADS 8
+#define GAMEPAD_EVDEV_PATH_MAX 96
+#define GAMEPAD_EVDEV_RESCAN_NS (1000LL * 1000 * 1000)
+
+//! What a node turned out to be.
+enum gamepad_evdev_probe
+{
+	GP_EVDEV_PROBE_PAD = 0,
+	GP_EVDEV_PROBE_NOT_A_PAD,
+	GP_EVDEV_PROBE_ERROR,
+};
+
+struct gamepad_evdev_ops
+{
+	void *ctx;
+	//! Call @p emit for each input node's path, in a stable order. -1 when the directory cannot be read.
+	int (*list)(void *ctx, void (*emit)(void *user, const char *path), void *user);
+	//! Open a node for reading without blocking. The descriptor, or -errno.
+	int (*open)(void *ctx, const char *path);
+	//! Is the open node a pad? Fills @p caps and @p name for a pad.
+	enum gamepad_evdev_probe (*probe)(void *ctx, int fd, struct gamepad_evdev_caps *caps, char *name, size_t name_size);
+	//! Read events like read(2): the byte count, 0 at end of file, -1 with errno (EAGAIN when none).
+	ssize_t (*read)(void *ctx, int fd, void *buf, size_t size);
+	//! Set the decoder from the device's own state after events were lost (EVIOCGKEY, EVIOCGABS).
+	void (*resync)(void *ctx, int fd, struct gamepad_evdev_decoder *d);
+	void (*close)(void *ctx, int fd);
+	//! True once per change of the node list (inotify), false otherwise.
+	bool (*changed)(void *ctx);
+	//! Monotonic nanoseconds.
+	int64_t (*now_ns)(void *ctx);
+	//! One line for the log: level 0 info, 1 warning.
+	void (*say)(void *ctx, int level, const char *line);
+};
+
+struct gamepad_evdev_pad
+{
+	bool used;
+	int fd;
+	char path[GAMEPAD_EVDEV_PATH_MAX];
+	char name[64];
+	struct gamepad_evdev_decoder dec;
+	int64_t last_report_ns;
+};
+
+struct gamepad_evdev_core
+{
+	struct gamepad_evdev_ops ops;
+	struct gamepad_evdev_pad pads[GAMEPAD_EVDEV_MAX_PADS];
+	//! Paths seen and set aside (not a pad, or an error already said), until they leave the list.
+	char skipped[32][GAMEPAD_EVDEV_PATH_MAX];
+	int skipped_count;
+	int64_t last_scan_ns;
+	bool scanned_once;
+	bool list_failed_said;
+	bool denied_said;
+};
+
+void
+gamepad_evdev_core_init(struct gamepad_evdev_core *c, const struct gamepad_evdev_ops *ops);
+
+//! Read the pads and set @p out (every field; `connected` false with none). `timestamp_ns` is left to the caller.
+void
+gamepad_evdev_core_poll(struct gamepad_evdev_core *c, struct gamepad_state *out);
+
+//! Close every pad.
+void
+gamepad_evdev_core_fini(struct gamepad_evdev_core *c);
+
+//! How many pads are open.
+int
+gamepad_evdev_core_pad_count(const struct gamepad_evdev_core *c);
+
+//! The name of the pad that speaks, or "" when none is open.
+const char *
+gamepad_evdev_core_speaking_name(const struct gamepad_evdev_core *c);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/xrt/drivers/gamepad/gamepad_evdev_decode.c b/src/xrt/drivers/gamepad/gamepad_evdev_decode.c
new file mode 100644
index 000000000..960bda44f
--- /dev/null
+++ b/src/xrt/drivers/gamepad/gamepad_evdev_decode.c
@@ -0,0 +1,276 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  The Linux pad decoder. See the header.
+ *
+ * @ingroup drv_gamepad
+ */
+
+#include "xrt/xrt_config_os.h"
+
+#ifdef XRT_OS_LINUX_DESKTOP
+
+#include "gamepad_evdev_decode.h"
+
+#include <linux/input.h>
+
+#include <string.h>
+
+static int
+axis_of_code(uint16_t code)
+{
+	switch (code) {
+	case ABS_X: return GP_EVDEV_AXIS_X;
+	case ABS_Y: return GP_EVDEV_AXIS_Y;
+	case ABS_RX: return GP_EVDEV_AXIS_RX;
+	case ABS_RY: return GP_EVDEV_AXIS_RY;
+	case ABS_Z: return GP_EVDEV_AXIS_Z;
+	case ABS_RZ: return GP_EVDEV_AXIS_RZ;
+	case ABS_HAT0X: return GP_EVDEV_AXIS_HAT0X;
+	case ABS_HAT0Y: return GP_EVDEV_AXIS_HAT0Y;
+	case ABS_HAT1X: return GP_EVDEV_AXIS_HAT1X;
+	case ABS_HAT1Y: return GP_EVDEV_AXIS_HAT1Y;
+	case ABS_HAT2X: return GP_EVDEV_AXIS_HAT2X;
+	case ABS_HAT2Y: return GP_EVDEV_AXIS_HAT2Y;
+	default: return -1;
+	}
+}
+
+static uint32_t
+button_of_code(uint16_t code)
+{
+	switch (code) {
+	case BTN_SOUTH: return GAMEPAD_BTN_A;
+	case BTN_EAST: return GAMEPAD_BTN_B;
+	case BTN_NORTH: return GAMEPAD_BTN_X;
+	case BTN_WEST: return GAMEPAD_BTN_Y;
+	case BTN_TL: return GAMEPAD_BTN_SHOULDER_LEFT;
+	case BTN_TR: return GAMEPAD_BTN_SHOULDER_RIGHT;
+	case BTN_THUMBL: return GAMEPAD_BTN_THUMB_LEFT;
+	case BTN_THUMBR: return GAMEPAD_BTN_THUMB_RIGHT;
+	case BTN_START: return GAMEPAD_BTN_MENU;
+	case BTN_SELECT: return GAMEPAD_BTN_VIEW;
+	case BTN_MODE: return GAMEPAD_BTN_GUIDE;
+	case BTN_DPAD_UP: return GAMEPAD_BTN_DPAD_UP;
+	case BTN_DPAD_DOWN: return GAMEPAD_BTN_DPAD_DOWN;
+	case BTN_DPAD_LEFT: return GAMEPAD_BTN_DPAD_LEFT;
+	case BTN_DPAD_RIGHT: return GAMEPAD_BTN_DPAD_RIGHT;
+	default: return 0;
+	}
+}
+
+static int32_t
+rest_value(const struct gamepad_evdev_axis_info *a, int axis)
+{
+	if (!a->present) {
+		return 0;
+	}
+	switch (axis) {
+	case GP_EVDEV_AXIS_X:
+	case GP_EVDEV_AXIS_Y:
+	case GP_EVDEV_AXIS_RX:
+	case GP_EVDEV_AXIS_RY: return a->min + (a->max - a->min) / 2;
+	case GP_EVDEV_AXIS_HAT0X:
+	case GP_EVDEV_AXIS_HAT0Y: return 0;
+	default: return a->min; // triggers and upper shoulders rest at their minimum
+	}
+}
+
+void
+gamepad_evdev_decoder_init(struct gamepad_evdev_decoder *d, const struct gamepad_evdev_caps *caps)
+{
+	memset(d, 0, sizeof(*d));
+	d->caps = *caps;
+	for (int i = 0; i < GP_EVDEV_AXIS_COUNT; i++) {
+		d->raw[i] = rest_value(&d->caps.axis[i], i);
+	}
+	d->state.connected = true;
+}
+
+void
+gamepad_evdev_decoder_set_key(struct gamepad_evdev_decoder *d, uint16_t code, bool down)
+{
+	if (code == BTN_TL2) {
+		d->key_tl2 = down;
+		return;
+	}
+	if (code == BTN_TR2) {
+		d->key_tr2 = down;
+		return;
+	}
+	const uint32_t bit = button_of_code(code);
+	if (bit == 0) {
+		return;
+	}
+	if (down) {
+		d->key_buttons |= bit;
+	} else {
+		d->key_buttons &= ~bit;
+	}
+}
+
+void
+gamepad_evdev_decoder_set_abs(struct gamepad_evdev_decoder *d, uint16_t code, int32_t value)
+{
+	const int axis = axis_of_code(code);
+	if (axis < 0 || !d->caps.axis[axis].present) {
+		return;
+	}
+	d->raw[axis] = value;
+	d->raw_seen[axis] = true;
+}
+
+//! -1..1 about the middle of the axis' range.
+static float
+signed_unit(const struct gamepad_evdev_axis_info *a, int32_t v)
+{
+	if (!a->present || a->max <= a->min) {
+		return 0.0f;
+	}
+	if (v < a->min) {
+		v = a->min;
+	}
+	if (v > a->max) {
+		v = a->max;
+	}
+	const double n = 2.0 * (double)((int64_t)v - a->min) / (double)((int64_t)a->max - a->min) - 1.0;
+	return (float)n;
+}
+
+//! 0..1 from the minimum of the axis' range.
+static float
+positive_unit(const struct gamepad_evdev_axis_info *a, int32_t v)
+{
+	if (!a->present || a->max <= a->min) {
+		return 0.0f;
+	}
+	if (v < a->min) {
+		v = a->min;
+	}
+	if (v > a->max) {
+		v = a->max;
+	}
+	return (float)((double)((int64_t)v - a->min) / (double)((int64_t)a->max - a->min));
+}
+
+static float
+max2(float a, float b)
+{
+	return a > b ? a : b;
+}
+
+void
+gamepad_evdev_decoder_commit(struct gamepad_evdev_decoder *d)
+{
+	const struct gamepad_evdev_caps *c = &d->caps;
+	struct gamepad_state s = d->state;
+	s.connected = true;
+	s.buttons = d->key_buttons;
+
+	// The d-pad as an analog hat: negative is left and up.
+	const struct gamepad_evdev_axis_info *hx = &c->axis[GP_EVDEV_AXIS_HAT0X];
+	const struct gamepad_evdev_axis_info *hy = &c->axis[GP_EVDEV_AXIS_HAT0Y];
+	if (hx->present) {
+		if (d->raw[GP_EVDEV_AXIS_HAT0X] < 0) {
+			s.buttons |= GAMEPAD_BTN_DPAD_LEFT;
+		} else if (d->raw[GP_EVDEV_AXIS_HAT0X] > 0) {
+			s.buttons |= GAMEPAD_BTN_DPAD_RIGHT;
+		}
+	}
+	if (hy->present) {
+		if (d->raw[GP_EVDEV_AXIS_HAT0Y] < 0) {
+			s.buttons |= GAMEPAD_BTN_DPAD_UP;
+		} else if (d->raw[GP_EVDEV_AXIS_HAT0Y] > 0) {
+			s.buttons |= GAMEPAD_BTN_DPAD_DOWN;
+		}
+	}
+
+	// Upper shoulders reported as analog buttons: pressed past the middle of the range.
+	const struct gamepad_evdev_axis_info *u_r = &c->axis[GP_EVDEV_AXIS_HAT1X];
+	const struct gamepad_evdev_axis_info *u_l = &c->axis[GP_EVDEV_AXIS_HAT1Y];
+	if (u_r->present && positive_unit(u_r, d->raw[GP_EVDEV_AXIS_HAT1X]) > 0.5f) {
+		s.buttons |= GAMEPAD_BTN_SHOULDER_RIGHT;
+	}
+	if (u_l->present && positive_unit(u_l, d->raw[GP_EVDEV_AXIS_HAT1Y]) > 0.5f) {
+		s.buttons |= GAMEPAD_BTN_SHOULDER_LEFT;
+	}
+
+	// Sticks. The kernel's "negative is left/up" becomes gamepad_state's +X right, +Y up.
+	s.left_x = signed_unit(&c->axis[GP_EVDEV_AXIS_X], d->raw[GP_EVDEV_AXIS_X]);
+	s.left_y = -signed_unit(&c->axis[GP_EVDEV_AXIS_Y], d->raw[GP_EVDEV_AXIS_Y]);
+	const bool has_rx = c->axis[GP_EVDEV_AXIS_RX].present && c->axis[GP_EVDEV_AXIS_RY].present;
+	const bool z_is_stick = !has_rx && c->axis[GP_EVDEV_AXIS_Z].present && c->axis[GP_EVDEV_AXIS_RZ].present;
+	if (has_rx) {
+		s.right_x = signed_unit(&c->axis[GP_EVDEV_AXIS_RX], d->raw[GP_EVDEV_AXIS_RX]);
+		s.right_y = -signed_unit(&c->axis[GP_EVDEV_AXIS_RY], d->raw[GP_EVDEV_AXIS_RY]);
+	} else if (z_is_stick) {
+		s.right_x = signed_unit(&c->axis[GP_EVDEV_AXIS_Z], d->raw[GP_EVDEV_AXIS_Z]);
+		s.right_y = -signed_unit(&c->axis[GP_EVDEV_AXIS_RZ], d->raw[GP_EVDEV_AXIS_RZ]);
+	} else {
+		s.right_x = 0.0f;
+		s.right_y = 0.0f;
+	}
+
+	// Lower triggers: the protocol's ABS_HAT2*, the legacy drivers' ABS_Z / ABS_RZ, else the digital keys.
+	float lt = positive_unit(&c->axis[GP_EVDEV_AXIS_HAT2Y], d->raw[GP_EVDEV_AXIS_HAT2Y]);
+	float rt = positive_unit(&c->axis[GP_EVDEV_AXIS_HAT2X], d->raw[GP_EVDEV_AXIS_HAT2X]);
+	if (!z_is_stick) {
+		lt = max2(lt, positive_unit(&c->axis[GP_EVDEV_AXIS_Z], d->raw[GP_EVDEV_AXIS_Z]));
+		rt = max2(rt, positive_unit(&c->axis[GP_EVDEV_AXIS_RZ], d->raw[GP_EVDEV_AXIS_RZ]));
+	}
+	if (d->key_tl2) {
+		lt = max2(lt, 1.0f);
+	}
+	if (d->key_tr2) {
+		rt = max2(rt, 1.0f);
+	}
+	s.left_trigger = lt;
+	s.right_trigger = rt;
+	d->state = s;
+}
+
+bool
+gamepad_evdev_decoder_feed(struct gamepad_evdev_decoder *d, const struct input_event *events, size_t count)
+{
+	bool committed = false;
+	for (size_t i = 0; i < count; i++) {
+		const struct input_event *e = &events[i];
+		if (e->type == EV_SYN) {
+			if (e->code == SYN_DROPPED) {
+				// The kernel's buffer overran: the rest of this batch is not to be trusted.
+				d->dropped = true;
+				d->needs_resync = true;
+			} else if (e->code == SYN_REPORT) {
+				if (d->dropped) {
+					d->dropped = false; // the lost batch ends here; the resync fills the state in
+				} else {
+					gamepad_evdev_decoder_commit(d);
+					committed = true;
+				}
+			}
+			continue;
+		}
+		if (d->dropped) {
+			continue;
+		}
+		if (e->type == EV_KEY) {
+			// value 2 is autorepeat: still down
+			gamepad_evdev_decoder_set_key(d, e->code, e->value != 0);
+		} else if (e->type == EV_ABS) {
+			gamepad_evdev_decoder_set_abs(d, e->code, e->value);
+		}
+	}
+	return committed;
+}
+
+bool
+gamepad_evdev_is_gamepad(const struct gamepad_evdev_caps *caps, bool has_south, bool has_rel)
+{
+	return has_south && !has_rel && caps->axis[GP_EVDEV_AXIS_X].present && caps->axis[GP_EVDEV_AXIS_Y].present;
+}
+
+#else
+// Keep the translation unit non-empty where this decoder is compiled out (-Wempty-translation-unit).
+typedef int gamepad_evdev_decode_not_built_here_t;
+#endif // XRT_OS_LINUX_DESKTOP
diff --git a/src/xrt/drivers/gamepad/gamepad_evdev_decode.h b/src/xrt/drivers/gamepad/gamepad_evdev_decode.h
new file mode 100644
index 000000000..55c016220
--- /dev/null
+++ b/src/xrt/drivers/gamepad/gamepad_evdev_decode.h
@@ -0,0 +1,124 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  The Linux pad decoder: evdev events in, @ref gamepad_state out. Pure.
+ *
+ * No file, no ioctl, no clock: the decoder is fed `struct input_event` arrays and keeps the pad's state, so
+ * `tests/tests_gamepad_evdev.cpp` runs it on synthetic arrays. The device layer (`gamepad_evdev_core.c`) opens
+ * the nodes and feeds it.
+ *
+ * The mapping follows the kernel's gamepad protocol (Documentation/input/gamepad.rst):
+ *   - BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST = A, B, X, Y by physical position (the Xbox layout names of
+ *     @ref gamepad_button; a Sony or Nintendo pad is mapped by position too);
+ *   - BTN_TL, BTN_TR (or ABS_HAT1Y, ABS_HAT1X pressed) = the upper shoulder buttons;
+ *   - the lower triggers are analog, 0..1: ABS_HAT2Y (left) and ABS_HAT2X (right) by the protocol, ABS_Z and
+ *     ABS_RZ in the legacy drivers (xpad, hid-microsoft, hid-sony); a pad that has only BTN_TL2, BTN_TR2 gives
+ *     0 or 1;
+ *   - BTN_SELECT = View, BTN_START = Menu, BTN_MODE = Guide, BTN_THUMBL and BTN_THUMBR = the stick clicks;
+ *   - the d-pad is BTN_DPAD_* or ABS_HAT0X and ABS_HAT0Y (negative is left and up), both read, either presses;
+ *   - the left stick is ABS_X and ABS_Y, the right stick ABS_RX and ABS_RY (ABS_Z and ABS_RZ on the old
+ *     pads that have no ABS_RX): for these axes "negative is left/up", so Y is negated to the +Y UP of
+ *     @ref gamepad_state.
+ * Each axis is normalised by its own range from EVIOCGABS: sticks to -1..1 about the middle of the range,
+ * triggers to 0..1 from the minimum.
+ *
+ * A report is a batch ended by SYN_REPORT; the state changes only there, so a half-read batch is never seen.
+ * SYN_DROPPED (the kernel's buffer overran) discards the batch and asks for a resync from the device's real
+ * state (EVIOCGKEY, EVIOCGABS), which the device layer feeds back through the same setters.
+ *
+ * @ingroup drv_gamepad
+ */
+
+#pragma once
+
+#include "gamepad_map.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct input_event;
+
+//! The absolute axes the decoder reads.
+enum gamepad_evdev_axis
+{
+	GP_EVDEV_AXIS_X = 0, //!< ABS_X, left stick
+	GP_EVDEV_AXIS_Y,     //!< ABS_Y
+	GP_EVDEV_AXIS_RX,    //!< ABS_RX, right stick
+	GP_EVDEV_AXIS_RY,    //!< ABS_RY
+	GP_EVDEV_AXIS_Z,     //!< ABS_Z, the legacy left trigger (or the right stick's X on a pad without ABS_RX)
+	GP_EVDEV_AXIS_RZ,    //!< ABS_RZ, the legacy right trigger (or the right stick's Y)
+	GP_EVDEV_AXIS_HAT0X, //!< the d-pad
+	GP_EVDEV_AXIS_HAT0Y,
+	GP_EVDEV_AXIS_HAT1X, //!< upper shoulders as analog buttons
+	GP_EVDEV_AXIS_HAT1Y,
+	GP_EVDEV_AXIS_HAT2X, //!< lower triggers
+	GP_EVDEV_AXIS_HAT2Y,
+	GP_EVDEV_AXIS_COUNT,
+};
+
+//! What the device reported about one axis (EVIOCGABS).
+struct gamepad_evdev_axis_info
+{
+	bool present;
+	int32_t min;
+	int32_t max;
+};
+
+//! What the device is: the axes it has and their ranges.
+struct gamepad_evdev_caps
+{
+	struct gamepad_evdev_axis_info axis[GP_EVDEV_AXIS_COUNT];
+};
+
+struct gamepad_evdev_decoder
+{
+	struct gamepad_evdev_caps caps;
+	uint32_t key_buttons;             //!< @ref gamepad_button bits set by keys
+	bool key_tl2, key_tr2;            //!< BTN_TL2, BTN_TR2 (digital lower triggers)
+	int32_t raw[GP_EVDEV_AXIS_COUNT]; //!< latest raw value of each axis
+	bool raw_seen[GP_EVDEV_AXIS_COUNT];
+	bool dropped;                     //!< a SYN_DROPPED is being skipped to its SYN_REPORT
+	bool needs_resync;                //!< the batch was lost: read the device's state and set it
+	struct gamepad_state state;       //!< the last committed report
+};
+
+//! Start from the device's capabilities: every key up, every axis at the middle of its range.
+void
+gamepad_evdev_decoder_init(struct gamepad_evdev_decoder *d, const struct gamepad_evdev_caps *caps);
+
+//! One key by its evdev code (EV_KEY): pressed or not. Codes the pad protocol does not use are ignored.
+void
+gamepad_evdev_decoder_set_key(struct gamepad_evdev_decoder *d, uint16_t code, bool down);
+
+//! One axis by its evdev code (EV_ABS). Codes the decoder does not read are ignored.
+void
+gamepad_evdev_decoder_set_abs(struct gamepad_evdev_decoder *d, uint16_t code, int32_t value);
+
+//! Compose the committed state from what was set (what SYN_REPORT does).
+void
+gamepad_evdev_decoder_commit(struct gamepad_evdev_decoder *d);
+
+/*!
+ * Feed @p count events. The state changes at each SYN_REPORT. Returns true when the state was committed at
+ * least once. @ref gamepad_evdev_decoder::needs_resync tells the device layer that events were lost.
+ */
+bool
+gamepad_evdev_decoder_feed(struct gamepad_evdev_decoder *d, const struct input_event *events, size_t count);
+
+/*!
+ * Is a device with these capabilities a gamepad by the kernel's protocol? It needs the BTN_GAMEPAD key
+ * (BTN_SOUTH), a left stick (ABS_X, ABS_Y) and no relative axes. @p has_south and @p has_rel are the device's
+ * key and event bits.
+ */
+bool
+gamepad_evdev_is_gamepad(const struct gamepad_evdev_caps *caps, bool has_south, bool has_rel);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/xrt/drivers/qwerty/qwerty_device.c b/src/xrt/drivers/qwerty/qwerty_device.c
