diff --git a/src/xrt/auxiliary/util/u_depth_limits.c b/src/xrt/auxiliary/util/u_depth_limits.c
new file mode 100644
index 000000000..d1a0b4cf5
--- /dev/null
+++ b/src/xrt/auxiliary/util/u_depth_limits.c
@@ -0,0 +1,441 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  The depth limits of a window's output and the camera rig that keeps to them. See the header.
+ */
+
+#include "util/u_depth_limits.h"
+
+#include "xrt/xrt_config_os.h"
+
+#include "os/os_threading.h"
+#include "util/u_file.h"
+
+#include <ctype.h>
+#include <stdatomic.h>
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+/*
+ *
+ * What the compositor announced.
+ *
+ */
+
+static struct
+{
+	struct os_mutex lock;
+	bool have;
+	struct u_depth_limits limits;
+	uint64_t serial;
+} g_announced;
+static atomic_int g_announced_state; // 0 not initialised, 1 initialising, 2 ready
+
+static void
+announced_lock(void)
+{
+	int expected = 0;
+	if (atomic_compare_exchange_strong(&g_announced_state, &expected, 1)) {
+		os_mutex_init(&g_announced.lock);
+		atomic_store(&g_announced_state, 2);
+	} else {
+		while (atomic_load(&g_announced_state) != 2) {
+		}
+	}
+	os_mutex_lock(&g_announced.lock);
+}
+
+static void
+announced_unlock(void)
+{
+	os_mutex_unlock(&g_announced.lock);
+}
+
+void
+u_depth_limits_publish(double sunk_px, double popped_px)
+{
+	announced_lock();
+	if (!g_announced.have || g_announced.limits.sunk_px != sunk_px || g_announced.limits.popped_px != popped_px) {
+		g_announced.have = true;
+		g_announced.limits.sunk_px = sunk_px;
+		g_announced.limits.popped_px = popped_px;
+		g_announced.serial++;
+	}
+	announced_unlock();
+}
+
+void
+u_depth_limits_withdraw(void)
+{
+	announced_lock();
+	if (g_announced.have) {
+		g_announced.have = false;
+		g_announced.serial++;
+	}
+	announced_unlock();
+}
+
+bool
+u_depth_limits_announced(struct u_depth_limits *out, uint64_t *out_serial)
+{
+	announced_lock();
+	const bool have = g_announced.have;
+	if (have && out != NULL) {
+		*out = g_announced.limits;
+	}
+	if (out_serial != NULL) {
+		*out_serial = g_announced.serial;
+	}
+	announced_unlock();
+	return have;
+}
+
+
+/*
+ *
+ * The person's choice.
+ *
+ */
+
+void
+u_depth_settings_default(struct u_depth_settings *s)
+{
+	memset(s, 0, sizeof(*s));
+	s->cls = U_VIEW_CLASS_AUTO;
+	s->strength_percent = 100.0;
+}
+
+static void
+say(char *message, size_t size, const char *fmt, const char *a, const char *b)
+{
+	if (message == NULL || size == 0) {
+		return;
+	}
+	size_t used = strlen(message);
+	if (used >= size) {
+		return;
+	}
+	snprintf(message + used, size - used, fmt, a, b);
+}
+
+//! One number, all of it, finite and within [lo, hi].
+static bool
+parse_number(const char *text, double lo, double hi, double *out)
+{
+	if (text == NULL || text[0] == '\0') {
+		return false;
+	}
+	char *end = NULL;
+	errno = 0;
+	const double v = strtod(text, &end);
+	if (end == text || errno != 0 || !isfinite(v)) {
+		return false;
+	}
+	while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n') {
+		end++;
+	}
+	if (*end != '\0' || v < lo || v > hi) {
+		return false;
+	}
+	*out = v;
+	return true;
+}
+
+//! The value of @p key in `key=value` lines; false if the key is not there. @p value is a trimmed copy.
+static bool
+file_value(const char *text, const char *key, char *value, size_t value_size)
+{
+	if (text == NULL) {
+		return false;
+	}
+	const size_t klen = strlen(key);
+	const char *p = text;
+	while (*p != '\0') {
+		const char *eol = strchr(p, '\n');
+		const size_t len = eol != NULL ? (size_t)(eol - p) : strlen(p);
+		if (len > klen && strncmp(p, key, klen) == 0 && p[klen] == '=') {
+			size_t n = len - klen - 1;
+			if (n >= value_size) {
+				n = value_size - 1;
+			}
+			memcpy(value, p + klen + 1, n);
+			value[n] = '\0';
+			while (n > 0 && (value[n - 1] == '\r' || value[n - 1] == ' ' || value[n - 1] == '\t')) {
+				value[--n] = '\0';
+			}
+			return true;
+		}
+		p += len;
+		if (*p == '\n') {
+			p++;
+		}
+	}
+	return false;
+}
+
+static bool
+file_unknown_keys(const char *text, char *message, size_t message_size)
+{
+	static const char *const keys[] = {"depth-strength", "screen-plane-mm", "sunk-px", "popped-px"};
+	if (text == NULL) {
+		return true;
+	}
+	bool ok = true;
+	const char *p = text;
+	while (*p != '\0') {
+		const char *eol = strchr(p, '\n');
+		const size_t len = eol != NULL ? (size_t)(eol - p) : strlen(p);
+		if (len > 0 && p[0] != '#' && !(len == 1 && p[0] == '\r')) {
+			bool known = false;
+			for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
+				const size_t kl = strlen(keys[i]);
+				if (len > kl && strncmp(p, keys[i], kl) == 0 && p[kl] == '=') {
+					known = true;
+				}
+			}
+			if (!known) {
+				char shown[48];
+				snprintf(shown, sizeof(shown), "%.*s", (int)(len < 40 ? len : 40), p);
+				say(message, message_size,
+				    "depth: the file view-depth holds the line \"%s\", which is not a key (accepted: "
+				    "depth-strength, screen-plane-mm, sunk-px, popped-px); ignored. %s",
+				    shown, "");
+				ok = false;
+			}
+		}
+		p += len;
+		if (*p == '\n') {
+			p++;
+		}
+	}
+	return ok;
+}
+
+//! One numeric setting: the environment first (a bad one is refused, never read past), then the file's key.
+static bool
+numeric(const char *env_name,
+        const char *key,
+        double lo,
+        double hi,
+        const char *(*env_get)(const char *, void *),
+        void *user,
+        const char *file_text,
+        double *out,
+        char *message,
+        size_t message_size)
+{
+	char buf[64];
+	const char *v = env_get != NULL ? env_get(env_name, user) : NULL;
+	if (v != NULL && v[0] != '\0') {
+		if (parse_number(v, lo, hi, out)) {
+			return true;
+		}
+		char shown[48];
+		snprintf(shown, sizeof(shown), "%.40s", v);
+		say(message, message_size, "depth: %s holds \"%s\", which is not a number in range; not applied. ", env_name,
+		    shown);
+		return false;
+	}
+	if (file_value(file_text, key, buf, sizeof(buf))) {
+		if (buf[0] == '\0') {
+			return true; // an empty value selects nothing
+		}
+		if (parse_number(buf, lo, hi, out)) {
+			return true;
+		}
+		char shown[48];
+		snprintf(shown, sizeof(shown), "%.40s", buf);
+		say(message, message_size,
+		    "depth: the file view-depth holds %s for \"%s\", which is not a number in range; not applied. ", key,
+		    shown);
+		return false;
+	}
+	return true;
+}
+
+bool
+u_depth_settings_parse(struct u_depth_settings *s,
+                       const char *(*env_get)(const char *name, void *user),
+                       void *user,
+                       const char *view_depth_text,
+                       const char *class_file_text,
+                       char *message,
+                       size_t message_size)
+{
+	u_depth_settings_default(s);
+	if (message != NULL && message_size > 0) {
+		message[0] = '\0';
+	}
+	bool ok = true;
+
+	// the class: the environment (a bad value is refused and the file is not read past it), then the file
+	const char *cv = env_get != NULL ? env_get("DXR_VIEW_CLASS", user) : NULL;
+	if (cv != NULL && cv[0] != '\0') {
+		if (!u_view_class_parse(cv, &s->cls)) {
+			char shown[48];
+			snprintf(shown, sizeof(shown), "%.40s", cv);
+			say(message, message_size,
+			    "depth: DXR_VIEW_CLASS holds \"%s\", which is not a display kind (accepted: " U_VIEW_CLASS_NAMES
+			    "); not applied. %s",
+			    shown, "");
+			s->cls = U_VIEW_CLASS_AUTO;
+			ok = false;
+		}
+	} else if (class_file_text != NULL) {
+		char line[64];
+		snprintf(line, sizeof(line), "%.60s", class_file_text);
+		char *nl = strchr(line, '\n');
+		if (nl != NULL) {
+			*nl = '\0';
+		}
+		size_t n = strlen(line);
+		while (n > 0 && (line[n - 1] == '\r' || line[n - 1] == ' ' || line[n - 1] == '\t')) {
+			line[--n] = '\0';
+		}
+		if (line[0] != '\0' && !u_view_class_parse(line, &s->cls)) {
+			say(message, message_size,
+			    "depth: the file view-class holds \"%s\", which is not a display kind (accepted: " U_VIEW_CLASS_NAMES
+			    "); not applied. %s",
+			    line, "");
+			s->cls = U_VIEW_CLASS_AUTO;
+			ok = false;
+		}
+	}
+
+	ok = file_unknown_keys(view_depth_text, message, message_size) && ok;
+	ok = numeric("DXR_VIEW_DEPTH_STRENGTH", "depth-strength", 0.0, 1000.0, env_get, user, view_depth_text,
+	             &s->strength_percent, message, message_size) && ok;
+	ok = numeric("DXR_VIEW_SCREEN_PLANE_MM", "screen-plane-mm", 0.0, 1.0e6, env_get, user, view_depth_text,
+	             &s->plane_mm, message, message_size) && ok;
+	ok = numeric("DXR_VIEW_SUNK_PX", "sunk-px", 0.0, 7680.0, env_get, user, view_depth_text, &s->sunk_px, message,
+	             message_size) && ok;
+	ok = numeric("DXR_VIEW_POPPED_PX", "popped-px", 0.0, 7680.0, env_get, user, view_depth_text, &s->popped_px,
+	             message, message_size) && ok;
+	return ok;
+}
+
+static const char *
+process_env(const char *name, void *user)
+{
+	(void)user;
+	return getenv(name);
+}
+
+//! The text of a small file in the configuration directory; NULL when it is not there. Caller frees.
+static char *
+read_config_file(const char *name)
+{
+#ifndef XRT_OS_WINDOWS
+	char path[1024];
+	const int n = u_file_get_path_in_config_dir(name, path, sizeof(path));
+	if (n <= 0 || (size_t)n >= sizeof(path)) {
+		return NULL;
+	}
+	FILE *f = fopen(path, "rb");
+	if (f == NULL) {
+		return NULL;
+	}
+	char *text = (char *)calloc(1, 4096);
+	if (text != NULL) {
+		const size_t got = fread(text, 1, 4095, f);
+		text[got] = '\0';
+	}
+	fclose(f);
+	return text;
+#else
+	(void)name;
+	return NULL; // Windows: the environment only, until the machine-wide configuration path is decided
+#endif
+}
+
+bool
+u_depth_settings_load(struct u_depth_settings *s, char *message, size_t message_size)
+{
+	char *depth = read_config_file("view-depth");
+	char *cls = read_config_file("view-class");
+	const bool ok = u_depth_settings_parse(s, process_env, NULL, depth, cls, message, message_size);
+	free(depth);
+	free(cls);
+	return ok;
+}
+
+
+/*
+ *
+ * Limits to the rig.
+ *
+ */
+
+bool
+u_depth_resolve(const struct u_depth_settings *s, const struct u_depth_limits *announced, struct u_depth_resolved *out)
+{
+	memset(out, 0, sizeof(*out));
+	out->source = U_DEPTH_SOURCE_NONE;
+	out->popped_px = -1.0;
+	out->plane_m = (s->plane_mm > 0.0 ? s->plane_mm : U_DEPTH_LIMITS_DEFAULT_PLANE_MM) / 1000.0;
+	if (announced == NULL && !(s->sunk_px > 0.0)) {
+		return false;
+	}
+	if (announced != NULL) {
+		const double factor = u_view_class_factor(s->cls) * s->strength_percent / 100.0;
+		out->source = U_DEPTH_SOURCE_COMPOSITOR;
+		out->sunk_px = announced->sunk_px * factor;
+		out->popped_px = announced->popped_px >= 0.0 ? announced->popped_px * factor : -1.0;
+	} else {
+		out->source = U_DEPTH_SOURCE_PERSON;
+	}
+	if (s->sunk_px > 0.0) {
+		out->sunk_px = s->sunk_px;
+		out->sunk_replaced = true;
+	}
+	if (s->popped_px > 0.0) {
+		out->popped_px = s->popped_px;
+		out->popped_replaced = true;
+	}
+	return true;
+}
+
+bool
+u_depth_rig_solve(const struct u_depth_rig_input *in, struct u_depth_rig *out)
+{
+	memset(out, 0, sizeof(*out));
+	out->nearest_m = -1.0;
+	out->popped_fraction = -1.0;
+	if (!(in->aspect > 0.0) || !(in->half_tan_vfov > 0.0) || !(in->m2v > 0.0) || !(in->eye_separation > 0.0) ||
+	    !(in->plane_m > 0.0) || !isfinite(in->sunk_px) || in->sunk_px < 0.0) {
+		return false;
+	}
+	const double s = in->sunk_px / U_DEPTH_LIMITS_VIEW_WIDTH;
+	// m2v cancels: the plane in world units is plane_m * m2v, and k carries m2v.
+	out->ipd_factor = (float)(s * in->plane_m * 2.0 * in->half_tan_vfov * in->aspect / in->eye_separation);
+	out->inv_convergence_distance = (float)(1.0 / (in->plane_m * in->m2v));
+	out->far_fraction = s;
+	if (in->popped_px >= 0.0) {
+		const double q = in->popped_px / U_DEPTH_LIMITS_VIEW_WIDTH;
+		out->popped_fraction = q;
+		out->nearest_m = (s + q) > 0.0 ? in->plane_m * s / (s + q) : in->plane_m;
+	}
+	return true;
+}
+
+double
+u_depth_rig_disparity(const struct u_depth_rig_input *in, const struct u_depth_rig *rig, double z_world)
+{
+	const double k = (double)rig->ipd_factor * in->m2v * in->eye_separation / (2.0 * in->half_tan_vfov * in->aspect);
+	const double inv_z = z_world > 0.0 ? 1.0 / z_world : 0.0;
+	return k * ((double)rig->inv_convergence_distance - inv_z);
+}
+
+double
+u_depth_limits_plane_for_nearest(double sunk_px, double popped_px, double nearest_m)
+{
+	if (!(sunk_px > 0.0) || popped_px < 0.0 || !(nearest_m > 0.0)) {
+		return -1.0;
+	}
+	return nearest_m * (sunk_px + popped_px) / sunk_px;
+}
diff --git a/src/xrt/auxiliary/util/u_depth_limits.h b/src/xrt/auxiliary/util/u_depth_limits.h
new file mode 100644
index 000000000..8b6ed4f33
--- /dev/null
+++ b/src/xrt/auxiliary/util/u_depth_limits.h
@@ -0,0 +1,191 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  How far a legacy application's picture may sink and pop, and the camera rig that keeps to it.
+ *
+ * ORDER 478 milestone 2b (Sparky Stereo OS). The limits are the desktop's: Stereo KWin announces, for the output a
+ * window mainly sits on, how far behind and in front of the screen anything may go (kde_stereo_depth_v1.depth_limits,
+ * since version 5), "in pixels of a view 1920 wide ... the user's limits built on the output's display: a headset gets
+ * more separation, a framed 3D screen less". A program reads them and draws inside them, so a page's popped element,
+ * the desktop's popped menu and a game's nearest thing agree on one screen. The same limits give a legacy
+ * application's camera rig its separation and screen plane, here.
+ *
+ * The order of importance is the browser's and the desktop's: the person's choice, built on the display. The person's
+ * choice is a class (tv or headset, the browser's flat modes), a strength in percent, a screen plane distance and, for
+ * either limit, an absolute value in pixels that replaces it. Nothing here is a number of ours: with no limits and no
+ * absolute value there is nothing to build on, and the caller says so.
+ *
+ * The closed form. A point Z in front of the camera (world units, metres for OpenVR) has, as a fraction of the canvas
+ * width and positive behind the screen plane, the disparity of docs/specs/runtime/legacy-camera-profile.md,
+ *
+ *   p(Z) = k (c - 1/Z),   k = ipd * m2v * eyeSeparation / (2 tan(vFov/2) aspect),   c = 1/D   (D = the plane's distance),
+ *
+ * so a point at infinity has p = k c. Infinity at the sunk limit s (sunk pixels / 1920) is k c = s, hence k = s D and
+ *
+ *   ipd = s D (2 tan(vFov/2) aspect) / (m2v eyeSeparation),   p(Z) = s (1 - D/Z).
+ *
+ * That is the browser's far parallax f (its sunk limit) and its screen plane (dom.vr.flat.screen-plane-mm). The popped
+ * limit (popped pixels / 1920 = q) is met at Z = D s / (s + q); anything nearer pops past it, because the camera does
+ * what the geometry says and a finished picture is never shifted. That distance is the scene's nearest working
+ * distance: a person who wants a scene to reach nearer moves the plane (D = Znear (s + q) / s), and
+ * u_depth_limits_plane_for_nearest() gives the plane for a nearest distance.
+ */
+
+#pragma once
+
+#include "util/u_view_class.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+//! Pixels of a view 1920 wide: the unit of the desktop's depth settings and of kde_stereo_depth_v1.
+#define U_DEPTH_LIMITS_VIEW_WIDTH 1920.0
+
+//! The browser's screen plane when the person has not set one (dom.vr.flat.screen-plane-mm 0): 1 m.
+#define U_DEPTH_LIMITS_DEFAULT_PLANE_MM 1000.0
+
+//! One pair of limits, pixels of a view 1920 wide. popped_px < 0: not known.
+struct u_depth_limits
+{
+	double sunk_px;
+	double popped_px;
+};
+
+/*
+ *
+ * What the compositor announced. One process-wide copy, written by whoever speaks to the compositor, read by the
+ * sessions. Safe from any thread.
+ *
+ */
+
+//! The compositor announced these limits for the output the window mainly sits on. Bumps the serial when they change.
+void
+u_depth_limits_publish(double sunk_px, double popped_px);
+
+//! The compositor no longer announces limits (the surface is gone, or it never could).
+void
+u_depth_limits_withdraw(void);
+
+//! The announced limits, if any; @p out_serial changes whenever they do.
+bool
+u_depth_limits_announced(struct u_depth_limits *out, uint64_t *out_serial);
+
+/*
+ *
+ * The person's choice.
+ *
+ */
+
+struct u_depth_settings
+{
+	enum u_view_class cls;           //!< tv, headset or auto
+	double strength_percent;         //!< of the limits, 100 = as they are; 0 switches depth off
+	double plane_mm;                 //!< the screen plane's distance, 0 = the default
+	double sunk_px;                  //!< replaces the sunk limit when above 0
+	double popped_px;                //!< replaces the popped limit when above 0
+	uint64_t serial;                 //!< changes whenever the settings are read again and differ
+};
+
+//! The settings with nothing chosen: auto, 100 %, the default plane, no absolute values.
+void
+u_depth_settings_default(struct u_depth_settings *s);
+
+/*!
+ * Read the person's choices: the class (DXR_VIEW_CLASS, else the file view-class), and DXR_VIEW_DEPTH_STRENGTH,
+ * DXR_VIEW_SCREEN_PLANE_MM, DXR_VIEW_SUNK_PX and DXR_VIEW_POPPED_PX, each else the same key in the file `view-depth`
+ * of the configuration directory (lines `key=value`: depth-strength, screen-plane-mm, sunk-px, popped-px).
+ * The file is read again by u_depth_settings_refresh() when it changes.
+ * A value that is wrong (not a number, below 0, a strength over 1000, an unknown key or class) is REFUSED, never
+ * silently dropped: @p message says which source held what and what is used instead (the value left at its default).
+ * Returns false if anything was refused.
+ */
+bool
+u_depth_settings_load(struct u_depth_settings *s, char *message, size_t message_size);
+
+//! The same from text instead of the process: @p env_get is called with a variable name and returns its value or NULL;
+//! @p view_depth_text is the content of the view-depth file or NULL; @p class_file_text that of view-class.
+bool
+u_depth_settings_parse(struct u_depth_settings *s,
+                       const char *(*env_get)(const char *name, void *user),
+                       void *user,
+                       const char *view_depth_text,
+                       const char *class_file_text,
+                       char *message,
+                       size_t message_size);
+
+/*
+ *
+ * Limits to the rig.
+ *
+ */
+
+//! Where the limits in force came from.
+enum u_depth_source
+{
+	U_DEPTH_SOURCE_NONE = 0,   //!< there are none
+	U_DEPTH_SOURCE_COMPOSITOR, //!< the compositor's, for the output
+	U_DEPTH_SOURCE_PERSON,     //!< the person's absolute values (no compositor limits)
+};
+
+//! The limits in force: the compositor's with the person's choices on top.
+struct u_depth_resolved
+{
+	enum u_depth_source source;
+	double sunk_px;   //!< pixels of a view 1920 wide; 0 = depth off
+	double popped_px; //!< negative = not known
+	double plane_m;
+	bool sunk_replaced;   //!< the person's absolute sunk value replaced the compositor's
+	bool popped_replaced;
+};
+
+/*!
+ * The person's choices on top of the compositor's limits (@p announced, or NULL when it announced none). Returns false
+ * and leaves @p out at U_DEPTH_SOURCE_NONE when there is nothing to build on: no compositor limits and no absolute
+ * sunk value.
+ */
+bool
+u_depth_resolve(const struct u_depth_settings *s, const struct u_depth_limits *announced, struct u_depth_resolved *out);
+
+//! What the rig is solved for.
+struct u_depth_rig_input
+{
+	double sunk_px;
+	double popped_px; //!< negative = not known
+	double plane_m;
+	double aspect;         //!< canvas width / height
+	double half_tan_vfov;  //!< tan(vFov / 2)
+	double m2v;            //!< metres to the app's world units
+	double eye_separation; //!< the display's reported eye separation, metres
+};
+
+struct u_depth_rig
+{
+	float ipd_factor;
+	float inv_convergence_distance; //!< 1 / plane, in world units
+	double far_fraction;            //!< p(infinity), a fraction of the canvas width, positive behind the plane
+	double nearest_m;               //!< where the popped limit is met; < 0 when the popped limit is not known
+	double popped_fraction;         //!< the popped limit as a fraction of the canvas width, < 0 when not known
+};
+
+//! False for an input the closed form cannot take (a non-positive aspect, field of view, m2v, eye separation or plane).
+bool
+u_depth_rig_solve(const struct u_depth_rig_input *in, struct u_depth_rig *out);
+
+//! The disparity of a point @p z_world in front of the camera for a rig, as a fraction of the canvas width, positive
+//! behind the plane (the closed form above).
+double
+u_depth_rig_disparity(const struct u_depth_rig_input *in, const struct u_depth_rig *rig, double z_world);
+
+//! The plane distance that makes the popped limit meet @p nearest_m; < 0 when the limits cannot give one.
+double
+u_depth_limits_plane_for_nearest(double sunk_px, double popped_px, double nearest_m);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/xrt/auxiliary/util/u_view_class.c b/src/xrt/auxiliary/util/u_view_class.c
new file mode 100644
index 000000000..37fb3655f
--- /dev/null
+++ b/src/xrt/auxiliary/util/u_view_class.c
@@ -0,0 +1,127 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief The person's choice of display kind for legacy applications' views.
+ *
+ * ORDER 478 milestones 2 and 2b (Sparky Stereo OS). The two names are the browser's flat modes (tv, headset). A
+ * class is a factor on the depth limits the compositor announces for the output (u_depth_limits.h), libstereo-policy's
+ * kind factors: a headset takes 2.5 times the separation of a framed screen. No number of the camera rig is chosen
+ * here: the rig follows from the limits.
+ */
+
+#include "util/u_view_class.h"
+
+#include "xrt/xrt_config_os.h"
+
+#include "util/u_file.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define VIEW_CLASS_FILE "view-class"
+#define VIEW_CLASS_ENV "DXR_VIEW_CLASS"
+
+static const char *const class_names[] = {"auto", "tv", "headset"};
+
+bool
+u_view_class_parse(const char *name, enum u_view_class *out)
+{
+	if (name == NULL)
+		return false;
+	for (size_t i = 1; i < sizeof(class_names) / sizeof(class_names[0]); i++) {
+		if (strcmp(name, class_names[i]) == 0) {
+			*out = (enum u_view_class)i;
+			return true;
+		}
+	}
+	return false;
+}
+
+const char *
+u_view_class_name(enum u_view_class cls)
+{
+	return class_names[cls == U_VIEW_CLASS_TV ? 1 : cls == U_VIEW_CLASS_HEADSET ? 2 : 0];
+}
+
+double
+u_view_class_factor(enum u_view_class cls)
+{
+	return cls == U_VIEW_CLASS_HEADSET ? U_VIEW_CLASS_HEADSET_FACTOR : U_VIEW_CLASS_TV_FACTOR;
+}
+
+static void
+say(char *message, size_t size, const char *source, const char *value)
+{
+	if (message == NULL || size == 0)
+		return;
+	snprintf(message, size,
+	         "view class: %s holds \"%.40s\", which is not a display kind; accepted: %s. Not applied: the "
+	         "compositor's limits (%s) are used until it is corrected",
+	         source, value, U_VIEW_CLASS_NAMES, class_names[U_VIEW_CLASS_AUTO]);
+}
+
+bool
+u_view_class_select(const char *env_value,
+                    const char *file_path,
+                    enum u_view_class *out,
+                    enum u_view_class_source *out_source,
+                    char *message,
+                    size_t message_size)
+{
+	if (message != NULL && message_size > 0)
+		message[0] = '\0';
+	*out = U_VIEW_CLASS_AUTO;
+	*out_source = U_VIEW_CLASS_FROM_DEFAULT;
+	if (env_value != NULL && env_value[0] != '\0') {
+		if (u_view_class_parse(env_value, out)) {
+			*out_source = U_VIEW_CLASS_FROM_ENVIRONMENT;
+			return true;
+		}
+		*out = U_VIEW_CLASS_AUTO;
+		say(message, message_size, VIEW_CLASS_ENV, env_value);
+		return false;
+	}
+	if (file_path != NULL) {
+		FILE *f = fopen(file_path, "r");
+		if (f != NULL) {
+			char line[64] = {0};
+			bool got = fgets(line, sizeof(line), f) != NULL;
+			fclose(f);
+			if (got) {
+				size_t n = strlen(line);
+				while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r' || line[n - 1] == ' '))
+					line[--n] = '\0';
+			}
+			if (!got || line[0] == '\0')
+				return true; // an empty file selects nothing: the display's default
+			if (u_view_class_parse(line, out)) {
+				*out_source = U_VIEW_CLASS_FROM_FILE;
+				return true;
+			}
+			*out = U_VIEW_CLASS_AUTO;
+			say(message, message_size, file_path, line);
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+u_view_class_select_for_process(enum u_view_class *out,
+                                enum u_view_class_source *out_source,
+                                char *message,
+                                size_t message_size)
+{
+	char path[1024];
+	const char *file = NULL;
+#ifndef XRT_OS_WINDOWS
+	int n = u_file_get_path_in_config_dir(VIEW_CLASS_FILE, path, sizeof(path));
+	if (n > 0 && (size_t)n < sizeof(path))
+		file = path;
+#else
+	(void)path; // Windows: the environment only, until the machine-wide configuration path is decided
+#endif
+	return u_view_class_select(getenv(VIEW_CLASS_ENV), file, out, out_source, message, message_size);
+}
diff --git a/src/xrt/auxiliary/util/u_view_class.h b/src/xrt/auxiliary/util/u_view_class.h
new file mode 100644
index 000000000..4ac94b289
--- /dev/null
+++ b/src/xrt/auxiliary/util/u_view_class.h
@@ -0,0 +1,74 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+//! The kind of display the person says a legacy application's two views are made for. The names are the browser's
+//! flat modes (`dom.vr.flat.mode`: tv, headset), so one idea has one name. The person chooses; the runtime never
+//! decides it from the output (one desktop can drive a 3D television and a viewer at the same time).
+enum u_view_class
+{
+	//! Nothing chosen: the depth limits of the output the compositor announces, as they are.
+	U_VIEW_CLASS_AUTO = 0,
+	//! A framed 3D screen (television, projector, monitor, anaglyph): the limits as the compositor announces them.
+	U_VIEW_CLASS_TV = 1,
+	//! A headset (or a phone in a viewer): libstereo-policy's headset factor over a framed screen's limits.
+	U_VIEW_CLASS_HEADSET = 2,
+};
+
+//! The names the selector takes.
+#define U_VIEW_CLASS_NAMES "tv, headset"
+
+//! libstereo-policy's kind factors (stereo_policy_display_depth, STEREO_POLICY_DISPLAY_*): framed 1.0, headset 2.5.
+#define U_VIEW_CLASS_TV_FACTOR 1.0
+#define U_VIEW_CLASS_HEADSET_FACTOR 2.5
+
+enum u_view_class_source
+{
+	U_VIEW_CLASS_FROM_DEFAULT = 0, //!< nothing set it: the limits as announced (U_VIEW_CLASS_AUTO)
+	U_VIEW_CLASS_FROM_ENVIRONMENT, //!< DXR_VIEW_CLASS
+	U_VIEW_CLASS_FROM_FILE,        //!< view-class in the runtime's configuration directory
+};
+
+//! Parse one selector value (exact, lower case). False for anything else; @p out is untouched.
+bool
+u_view_class_parse(const char *name, enum u_view_class *out);
+
+//! The selector's name, as u_view_class_parse takes it; "auto" for U_VIEW_CLASS_AUTO.
+const char *
+u_view_class_name(enum u_view_class cls);
+
+//! The factor a class puts on the limits the compositor announces (auto and tv 1, headset 2.5).
+double
+u_view_class_factor(enum u_view_class cls);
+
+/*!
+ * Resolve the person's selector, in this order: the environment value @p env_value (DXR_VIEW_CLASS), then the
+ * first line of the file @p file_path (NULL = no file), then the default of the display. A value that is not a
+ * class name is REFUSED: @p out is the default, the result is false and @p message says which source held it,
+ * what it was and which names are accepted, so the caller can tell the person. Never silent.
+ */
+bool
+u_view_class_select(const char *env_value,
+                    const char *file_path,
+                    enum u_view_class *out,
+                    enum u_view_class_source *out_source,
+                    char *message,
+                    size_t message_size);
+
+//! u_view_class_select with the process environment and view-class in the configuration directory.
+bool
+u_view_class_select_for_process(enum u_view_class *out,
+                                enum u_view_class_source *out_source,
+                                char *message,
+                                size_t message_size);
+
+#ifdef __cplusplus
+}
+#endif
