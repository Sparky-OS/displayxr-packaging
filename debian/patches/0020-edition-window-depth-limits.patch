diff --git a/src/xrt/compositor/vk_native/comp_vk_native_depth.c b/src/xrt/compositor/vk_native/comp_vk_native_depth.c
new file mode 100644
index 000000000..a08e90f82
--- /dev/null
+++ b/src/xrt/compositor/vk_native/comp_vk_native_depth.c
@@ -0,0 +1,124 @@
+// Copyright 2026, Daniel Campos Ramos
+// SPDX-License-Identifier: BSL-1.0
+#include "comp_vk_native_depth.h"
+#include <stereo-declare.h>
+#include <wayland-client.h>
+#include <pthread.h>
+#include <poll.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+struct comp_vk_native_depth {
+ pthread_t thread;
+ pthread_mutex_t lock;
+ struct wl_display *display;
+ struct wl_surface *surface;
+ uint32_t xwindow;
+ int wake[2];
+ double shown_width, sampled_width;
+ int result;
+ struct stereo_depth_limits limits;
+};
+
+static void *
+observe(void *arg)
+{
+ struct comp_vk_native_depth *d = arg;
+ struct wl_event_queue *queue = NULL;
+ Display *xdisplay = NULL;
+ int init = 0;
+ if (d->display) {
+  queue = wl_display_create_queue(d->display);
+  init = queue ? stereo_declare_wayland_init(d->display, queue) : -ENOMEM;
+ } else {
+  xdisplay = XOpenDisplay(NULL);
+  init = xdisplay ? 0 : -ENOTCONN;
+ }
+ for (;;) {
+  pthread_mutex_lock(&d->lock);
+  double width = d->shown_width;
+  pthread_mutex_unlock(&d->lock);
+  struct stereo_depth_limits limits;
+  int rc = init;
+  if (rc == 0) {
+   // The camera solver uses fractions of a 1920-wide eye. The library alone
+   // converts the output limits to that coordinate system for this window.
+   rc = d->display ? stereo_depth_wayland_get_buffer_limits(d->surface, 1920.0, width, &limits)
+                   : stereo_depth_x11_get_buffer_limits(xdisplay, d->xwindow, 1920.0, width, &limits);
+  }
+  pthread_mutex_lock(&d->lock);
+  d->result = rc;
+  d->sampled_width = width;
+  if (rc == 0) d->limits = limits;
+  pthread_mutex_unlock(&d->lock);
+  struct pollfd fds[2] = {{d->wake[0], POLLIN, 0}, {-1, POLLIN, 0}};
+  bool prepared = false;
+  if (d->display && init == 0) {
+   if (wl_display_dispatch_queue_pending(d->display, queue) < 0) init = -EPIPE;
+   else if (wl_display_prepare_read_queue(d->display, queue) == 0) {
+    prepared = true;
+    wl_display_flush(d->display);
+    fds[1].fd = wl_display_get_fd(d->display);
+   } else continue;
+  }
+  int polled;
+  do { polled = poll(fds, 2, 50); } while (polled < 0 && errno == EINTR);
+  if (prepared) {
+   if (fds[1].revents & POLLIN) {
+    if (wl_display_read_events(d->display) < 0) init = -EPIPE;
+    else if (wl_display_dispatch_queue_pending(d->display, queue) < 0) init = -EPIPE;
+   } else wl_display_cancel_read(d->display);
+   if (fds[1].revents & (POLLERR | POLLHUP)) init = -EPIPE;
+  }
+  if (polled < 0 || fds[0].revents) break;
+ }
+ if (d->display && queue) {
+  stereo_depth_wayland_unwatch(d->surface);
+  stereo_declare_wayland_finish();
+  wl_event_queue_destroy(queue);
+ }
+ if (xdisplay) XCloseDisplay(xdisplay);
+ return NULL;
+}
+
+struct comp_vk_native_depth *
+comp_vk_native_depth_create(void *display, void *surface, uint32_t xwindow)
+{
+ if ((!display || !surface) && !xwindow) return NULL;
+ struct comp_vk_native_depth *d = calloc(1, sizeof(*d));
+ if (!d) return NULL;
+ d->display = display; d->surface = surface; d->xwindow = xwindow;
+ d->result = -ENODATA;
+ if (pthread_mutex_init(&d->lock, NULL) != 0) { free(d); return NULL; }
+ if (pipe(d->wake) != 0) { pthread_mutex_destroy(&d->lock); free(d); return NULL; }
+ if (pthread_create(&d->thread, NULL, observe, d) != 0) {
+  close(d->wake[0]); close(d->wake[1]); pthread_mutex_destroy(&d->lock); free(d); return NULL;
+ }
+ return d;
+}
+
+int
+comp_vk_native_depth_get(struct comp_vk_native_depth *d, double shown_width, struct u_depth_limits *out)
+{
+ if (!d) return -ENOTSUP;
+ pthread_mutex_lock(&d->lock);
+ d->shown_width = shown_width;
+ int result = shown_width == d->sampled_width ? d->result : -ENODATA;
+ if (result == 0) { out->sunk_px = d->limits.sunk; out->popped_px = d->limits.popped; }
+ pthread_mutex_unlock(&d->lock);
+ return result;
+}
+
+void
+comp_vk_native_depth_destroy(struct comp_vk_native_depth **ptr)
+{
+ if (!ptr || !*ptr) return;
+ struct comp_vk_native_depth *d = *ptr;
+ const char stop = 1;
+ (void)write(d->wake[1], &stop, 1);
+ pthread_join(d->thread, NULL);
+ close(d->wake[0]); close(d->wake[1]);
+ pthread_mutex_destroy(&d->lock);
+ free(d); *ptr = NULL;
+}
