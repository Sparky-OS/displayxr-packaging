--- a/src/xrt/compositor/vk_native/comp_vk_native_compositor.c
+++ b/src/xrt/compositor/vk_native/comp_vk_native_compositor.c
@@ -163,6 +163,7 @@
 // generated by wayland-scanner; CMake defines this for this TU when it can).
 #if defined(XRT_HAVE_WAYLAND) && defined(DXR_HAVE_WL_STEREO)
 #include "vk_native/comp_vk_native_wl_stereo.h"
+#include "vk_native/comp_vk_native_problems.h"
 #endif
 
 #include <string.h>
@@ -5948,6 +5949,8 @@ vk_full_sbs_refresh_locked(struct comp_vk_native_compositor *c)
 
 		bool declare = false;
 		const char *refused = NULL;
+		// What the person is told (comp_vk_native_problems.h); OK for a refusal the person chose.
+		enum comp_vk_native_declare_problem problem = COMP_VK_NATIVE_DECLARE_OK;
 		uint32_t x11_supported = 0;
 		(void)x11_supported;
 		if (c->full_sbs.dp_wants) {
@@ -5959,6 +5962,12 @@ vk_full_sbs_refresh_locked(struct comp_vk_native_compositor *c)
 				if (c->use_wayland) {
 					declare = c->wl_stereo != NULL;
 					refused = declare ? NULL : c->wl_stereo_missing;
+					// The global is missing or too old: the desktop announces nothing usable;
+					// every other reason (no surface, no memory, a failed roundtrip) is "other".
+					problem = declare ? COMP_VK_NATIVE_DECLARE_OK
+					          : strstr(refused, "kde_stereo_content_manager_v1") != NULL
+					              ? COMP_VK_NATIVE_DECLARE_NO_ANNOUNCEMENT
+					              : COMP_VK_NATIVE_DECLARE_OTHER;
 				} else
 #endif
 #ifdef XRT_OS_LINUX_DESKTOP
@@ -5966,21 +5975,30 @@ vk_full_sbs_refresh_locked(struct comp_vk_native_compositor *c)
 					refused =
 					    comp_vk_native_window_xcb_full_sbs_refusal(c->xcb_window, &x11_supported);
 					declare = refused == NULL;
+					if (!declare) {
+						problem = strstr(refused, "announces no stereo declaration") != NULL ||
+						                  strstr(refused, "older than version 3") != NULL
+						              ? COMP_VK_NATIVE_DECLARE_NO_ANNOUNCEMENT
+						              : COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE;
+					}
 				} else if (!c->owns_window && c->xcb_handle.connection != NULL) {
 					refused =
 					    "the window is the app's own X11 window (XR_DXR_xlib_window_binding), "
 					    "and on X11 only the runtime's own window is declared so far";
+					problem = COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE;
 				} else
 #endif
 				{
 					refused =
 					    "the window is neither a native Wayland surface nor the runtime's own "
 					    "X11 window";
+					problem = COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE;
 #if defined(XRT_HAVE_WAYLAND) && !defined(DXR_HAVE_WL_STEREO)
 					if (c->use_wayland) {
 						refused =
 						    "this runtime was built without wayland-scanner, so it "
 						    "cannot declare";
+						problem = COMP_VK_NATIVE_DECLARE_BUILT_WITHOUT_SCANNER;
 					}
 #endif
 				}
@@ -5995,6 +6013,9 @@ vk_full_sbs_refresh_locked(struct comp_vk_native_compositor *c)
 			    refused);
 		}
 		c->full_sbs.refused = refused;
+		// The person is told where they look (the log said it already): kept until the window is declared
+		// again, or until the display processor no longer wants the declaration (a 2D mode).
+		comp_vk_native_problems_declare(problem, refused);
 
 		if (declare != c->full_sbs.declared) {
 			c->full_sbs.declared = declare;
diff --git a/src/xrt/compositor/vk_native/comp_vk_native_problems.c b/src/xrt/compositor/vk_native/comp_vk_native_problems.c
new file mode 100644
index 000000000..2087f56c1
--- /dev/null
+++ b/src/xrt/compositor/vk_native/comp_vk_native_problems.c
@@ -0,0 +1,170 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Tell the person when the runtime cannot declare its window (sparky-stereo-problems).
+ * @ingroup comp_vk_native
+ */
+
+#include "comp_vk_native_problems.h"
+
+#include "util/u_logging.h"
+
+#ifdef DXR_SPARKY_PROBLEMS
+
+#include <sparky-stereo-problems.h>
+
+#include <dlfcn.h>
+#include <stdbool.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+#define PACKAGE "displayxr-runtime"
+#define KEY "declare"
+
+typedef int (*keep_fn)(int, const char *, const char *, const char *, const char *const *, int, const char *);
+typedef int (*clear_fn)(int, const char *, const char *);
+typedef const char *(*error_fn)(void);
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static bool opened;
+static keep_fn keep;
+static clear_fn clear;
+static error_fn error_en;
+
+//! @p quiet: nothing is being told (the window is declared), so an absent engine is an INFO line, not an error.
+static bool
+engine_open(bool quiet)
+{
+	if (opened) {
+		return keep != NULL;
+	}
+	opened = true;
+	const enum u_logging_level level = quiet ? U_LOGGING_INFO : U_LOGGING_ERROR;
+	void *lib = dlopen(DXR_SPARKY_PROBLEMS_LIBRARY, RTLD_NOW | RTLD_LOCAL);
+	if (lib == NULL) {
+		U_LOG(level, "sparky-stereo-problems: %s: %s", dlerror(),
+		      quiet ? "nothing to end (the window is declared)" : "the person cannot be told why the window is not declared");
+		return false;
+	}
+	keep_fn k = (keep_fn)dlsym(lib, "ssp_keep");
+	clear_fn c = (clear_fn)dlsym(lib, "ssp_clear");
+	error_en = (error_fn)dlsym(lib, "ssp_error_en");
+	if (k == NULL || c == NULL || error_en == NULL) {
+		U_LOG(level, "sparky-stereo-problems: %s lacks ssp_keep, ssp_clear or ssp_error_en: %s",
+		      DXR_SPARKY_PROBLEMS_LIBRARY,
+		      quiet ? "nothing to end (the window is declared)" : "the person cannot be told why the window is not declared");
+		return false;
+	}
+	keep = k;
+	clear = c;
+	return true;
+}
+
+static const char *
+message_of(enum comp_vk_native_declare_problem kind)
+{
+	// The package's own messages (debian/lang, built into catalogs); LOCAL1 is the title.
+	switch (kind) {
+	case COMP_VK_NATIVE_DECLARE_NO_ANNOUNCEMENT: return "LOCAL2";
+	case COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE: return "LOCAL3";
+	case COMP_VK_NATIVE_DECLARE_BUILT_WITHOUT_SCANNER: return "LOCAL4";
+	default: return "LOCAL5";
+	}
+}
+
+static const char *
+english_of(enum comp_vk_native_declare_problem kind)
+{
+	// Said when the package's catalog is not there; the catalog says it in the person's language.
+	switch (kind) {
+	case COMP_VK_NATIVE_DECLARE_NO_ANNOUNCEMENT:
+		return "DisplayXR cannot show this program in 3D: the desktop does not announce the stereo declaration "
+		       "that DisplayXR needs, so the program is shown as its two views side by side, flat. Use Stereo "
+		       "KWin (the desktop of Sparky Stereo OS), then start the program again.";
+	case COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE:
+		return "DisplayXR cannot show this program in 3D: its window is one DisplayXR does not declare to the "
+		       "desktop, so the program is shown as its two views side by side, flat.";
+	case COMP_VK_NATIVE_DECLARE_BUILT_WITHOUT_SCANNER:
+		return "DisplayXR cannot show this program in 3D: this build of the runtime has no Wayland "
+		       "declaration, so the program is shown as its two views side by side, flat. Install the "
+		       "displayxr-runtime package of your distribution.";
+	default:
+		return "DisplayXR cannot show this program in 3D: the declaration to the desktop could not be "
+		       "made, so the program is shown as its two views side by side, flat.";
+	}
+}
+
+//! Writes the JSON string of @p in, escaped, into @p out; false when it does not fit.
+static bool
+json_string(char *out, size_t size, const char *in)
+{
+	size_t n = 0;
+	for (; *in != '\0'; in++) {
+		const unsigned char ch = (unsigned char)*in;
+		const char *esc = ch == '"' ? "\\\"" : ch == '\\' ? "\\\\" : NULL;
+		if (esc == NULL && ch < 0x20) {
+			esc = " ";
+		}
+		const size_t add = esc != NULL ? strlen(esc) : 1;
+		if (n + add + 1 > size) {
+			return false;
+		}
+		if (esc != NULL) {
+			memcpy(out + n, esc, add);
+		} else {
+			out[n] = (char)ch;
+		}
+		n += add;
+	}
+	out[n] = '\0';
+	return true;
+}
+
+void
+comp_vk_native_problems_declare(enum comp_vk_native_declare_problem kind, const char *detail)
+{
+	pthread_mutex_lock(&lock);
+	if (kind == COMP_VK_NATIVE_DECLARE_OK) {
+		// A problem an earlier start of any program kept ends here: the engine ends nothing that is not there.
+		if (engine_open(true) && clear(SSP_PERSON, PACKAGE, KEY) != 0) {
+			U_LOG_E("sparky-stereo-problems: the window is declared but the earlier problem could not be "
+			        "ended: %s",
+			        error_en());
+		}
+		pthread_mutex_unlock(&lock);
+		return;
+	}
+	if (!engine_open(false)) {
+		pthread_mutex_unlock(&lock);
+		return;
+	}
+	char text[1024];
+	char escaped[2048];
+	char details[3200];
+	snprintf(text, sizeof text, "%s DisplayXR says: %s", english_of(kind), detail != NULL ? detail : "");
+	if (!json_string(escaped, sizeof escaped, text) ||
+	    snprintf(details, sizeof details, "{\"text_en\":\"%s\"}", escaped) >=
+	        (int)sizeof details) {
+		U_LOG_E("sparky-stereo-problems: the problem text does not fit");
+		pthread_mutex_unlock(&lock);
+		return;
+	}
+	const char *args[1] = {detail != NULL ? detail : ""};
+	if (keep(SSP_PERSON, PACKAGE, KEY, message_of(kind), args, 1, details) != 0) {
+		U_LOG_E("sparky-stereo-problems: the problem could not be kept: %s", error_en());
+	}
+	pthread_mutex_unlock(&lock);
+}
+
+#else // !DXR_SPARKY_PROBLEMS
+
+void
+comp_vk_native_problems_declare(enum comp_vk_native_declare_problem kind, const char *detail)
+{
+	(void)kind;
+	(void)detail;
+}
+
+#endif
diff --git a/src/xrt/compositor/vk_native/comp_vk_native_problems.h b/src/xrt/compositor/vk_native/comp_vk_native_problems.h
new file mode 100644
index 000000000..9bf831294
--- /dev/null
+++ b/src/xrt/compositor/vk_native/comp_vk_native_problems.h
@@ -0,0 +1,56 @@
+// Copyright 2026, The DisplayXR Project
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Tell the person when the runtime cannot declare its window to the desktop.
+ *
+ * The runtime hands a stereo desktop compositor the two views side by side and
+ * declares the window once (comp_vk_native_wl_stereo, the X11 property). When
+ * the declaration cannot be made the views are shown flat, side by side, and
+ * the reason used to reach the log only. A distribution that has a place where
+ * the person is told about failures (Sparky Stereo OS: sparky-stereo-problems,
+ * its session notifier and the Problems page of System Settings) builds this
+ * with DXR_SPARKY_PROBLEMS: the reason is kept there until a declaring start
+ * clears it. Without the option every call is a no-op and nothing is linked.
+ *
+ * The engine's library is opened with dlopen at the first call, so the runtime
+ * keeps its list of linked libraries (and starts) where the engine is absent;
+ * then the log says, as an error, that the person could not be told.
+ *
+ * @ingroup comp_vk_native
+ */
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+//! Why the window is not declared. The kinds are the messages a catalog says in
+//! the person's language; the detail is the runtime's own English sentence.
+enum comp_vk_native_declare_problem
+{
+	//! Declared, or nothing to declare (a 2D mode, DXR_STEREO_DECLARE=0 chosen by the person).
+	COMP_VK_NATIVE_DECLARE_OK = 0,
+	//! The desktop announces no stereo declaration (or an older one than the runtime needs).
+	COMP_VK_NATIVE_DECLARE_NO_ANNOUNCEMENT,
+	//! The window is one the runtime does not declare (the app's own X11 window, a child window).
+	COMP_VK_NATIVE_DECLARE_WINDOW_NOT_DECLARABLE,
+	//! This runtime was built without wayland-scanner.
+	COMP_VK_NATIVE_DECLARE_BUILT_WITHOUT_SCANNER,
+	//! Any other reason the declaration could not be made.
+	COMP_VK_NATIVE_DECLARE_OTHER,
+};
+
+/*!
+ * Keeps the problem for @p kind with @p detail (the person's problem, key
+ * "declare"; kept again with the same kind it keeps its first time), or, for
+ * COMP_VK_NATIVE_DECLARE_OK, ends it. Called when the answer changes, never per
+ * frame. Failures of the engine itself are logged as errors.
+ */
+void
+comp_vk_native_problems_declare(enum comp_vk_native_declare_problem kind, const char *detail);
+
+#ifdef __cplusplus
+}
+#endif
