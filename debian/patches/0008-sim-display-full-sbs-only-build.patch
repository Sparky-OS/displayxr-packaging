 			else if (strcmp(mode_str, "anaglyph") == 0)
@@ -633,6 +661,7 @@ sim_display_hmd_create(void)
 				        "2d|anaglyph|sbs|squeezed|quad|blend|interlaced|sbs_full) — keeping the "
